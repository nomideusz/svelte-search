{
  "name": "@nomideusz/svelte-search",
  "version": "1.0.0",
  "description": "Search for Svelte 5 apps and any JS backend — SQLite FTS5 or Postgres full text, per-word typo tolerance, geo proximity, autocomplete with an accessible SearchBox, any language.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./locales/pl": {
      "types": "./dist/locales/pl.d.ts",
      "default": "./dist/locales/pl.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "package": "svelte-kit sync && svelte-package",
    "prepublishOnly": "npm run package",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "postgres": "^3.4.9",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "svelte",
    "search",
    "fts5",
    "trigram",
    "fuzzy",
    "geo",
    "autocomplete",
    "sqlite",
    "postgres",
    "combobox",
    "typo-tolerance",
    "i18n"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nomideusz/svelte-search"
  },
  "homepage": "https://svelte.zaur.app/search"
}
